{
    "name": "liquiddesign/liquid-monitor-connector",
    "description": "Connector mezi webem a Liquid Monitor",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LiquidMonitorConnector\\": "src/"
        }
    },
    "bin": [
        "bin/orchestrator-run",
        "bin/orchestrator-guard",
        "bin/orchestrator-init",
        "bin/monitor-worker",
        "bin/monitor-telemetry-agent",
        "bin/lqcron"
    ],
    "require": {
        "php": ">=8.0",
        "nette/utils": "^3.0 || ^4.0",
        "nette/http": "^3.0",
        "nette/application": "^3.0",
        "nette/security": "^3.0",
        "tracy/tracy": "^2.0",
        "nette/di": "~3.0",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "nesbot/carbon": "^2.0 || ^3.0",
        "liquiddesign/nette-log-viewer": "^1.2.4",
        "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dotenv": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "dragonmantank/cron-expression": "^3.3"
    },
    "require-dev": {
        "nette/tester": "^2.0",
        "composer/composer": "~2.0",
        "liquiddesign/codestyle": "~3.0.9",
        "liquiddesign/migrator": "~1.0",
        "phpstan/phpstan-nette": "^2.0",
        "phpcompatibility/php-compatibility": "^9.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Lokální plánovač lqcron (scheduler.enabled) — potřeba jedno z ext-pdo_sqlite / ext-sqlite3, i v PHP-FPM, které joby zařazuje",
        "ext-sqlite3": "Lokální plánovač lqcron (scheduler.enabled) — potřeba jedno z ext-pdo_sqlite / ext-sqlite3, i v PHP-FPM, které joby zařazuje"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "fix-code": [
            "@phpcsfix"
        ],
        "code-style": [
            "@phpcsfix",
            "@phpcs"
        ],
        "check-code": [
            "@phpcs",
            "@phpstan"
        ],
        "phpstan": "phpstan analyse --memory-limit 1G -c phpstan.neon",
        "phpcs": "phpcs --standard=ruleset.xml --ignore=assets src",
        "phpcsfix": "phpcbf --standard=ruleset.xml --ignore=assets src",
        "post-install-cmd": [
            "git config core.hooksPath scripts/hooks 2>/dev/null || true"
        ],
        "post-update-cmd": [
            "git config core.hooksPath scripts/hooks 2>/dev/null || true"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev",
            "dev-1.x": "1.x-dev",
            "dev-3.x": "3.x-dev",
            "dev-4.x": "4.x-dev"
        }
    }
}
