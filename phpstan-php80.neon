# Analýza s PHP 8.0 parserem — jen nad vendor/ nainstalovaným pro PHP 8.0 (CI job 8.0, --prefer-lowest),
# jinak vendor/ s 8.1+ syntaxí nejde načíst. Lokálně stačí phpstan.neon (rozsah z composer.json).
includes:
	- phpstan.neon

parameters:
	phpVersion: 80000
	# The lowest nette/* releases lack annotations the code relies on; these are
	# not bugs in the connector, only missing type information in old vendor/.
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		# nette/application < 3.2 does not declare Presenter::sendResponse() as never.
		- message: '#should always throw an exception or terminate script execution but doesn''t do that#'
		  path: src/DbQuery/DbQueryApiPresenter.php
		# nette/utils < 4 does not narrow Arrays::isList() to a list.
		- message: '#expects list<array<string, mixed>>, array<mixed, mixed> given#'
		  path: src/Telemetry/Agent/MonitorSink.php
