#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace LiquidMonitorConnector\Bin;

use LiquidMonitorConnector\Telemetry\Agent\Aggregator;
use LiquidMonitorConnector\Telemetry\Agent\JsonlFileSink;
use LiquidMonitorConnector\Telemetry\Agent\MonitorSink;
use LiquidMonitorConnector\Telemetry\Agent\TelemetryAgent;
use LiquidMonitorConnector\Telemetry\TelemetryConfig;

$autoloadCandidates = [
	__DIR__ . '/../vendor/autoload.php',
	__DIR__ . '/../../../autoload.php',
];

$autoloadFound = false;

foreach ($autoloadCandidates as $candidate) {
	if (\is_file($candidate)) {
		require $candidate;
		$autoloadFound = true;

		break;
	}
}

if (!$autoloadFound) {
	\fwrite(\STDERR, "monitor-telemetry-agent: could not locate vendor/autoload.php\n");
	exit(1);
}

$options = \getopt('', ['host::', 'port::', 'max-runtime::', 'out-dir:', 'monitor-url::']);
$outDir = \is_string($options['out-dir'] ?? null) ? $options['out-dir'] : null;

if ($outDir === null) {
	\fwrite(\STDERR, "usage: [LQDECK_API_KEY=…] monitor-telemetry-agent --out-dir=DIR [--monitor-url=https://…/api/connector] [--host=127.0.0.1] [--port=" . TelemetryConfig::DEFAULT_PORT . "] [--max-runtime=65]\n");
	exit(2);
}

$host = \is_string($options['host'] ?? null) ? $options['host'] : '127.0.0.1';
$port = \is_string($options['port'] ?? null) ? (int) $options['port'] : TelemetryConfig::DEFAULT_PORT;
$maxRuntime = \is_string($options['max-runtime'] ?? null) ? (int) $options['max-runtime'] : 65;

// API klíč přes prostředí, ne v příkazové řádce — ta je v `ps` vidět všem uživatelům stroje.
$monitorUrl = \is_string($options['monitor-url'] ?? null) ? $options['monitor-url'] : null;
$apiKey = \getenv('LQDECK_API_KEY');
$sink = $monitorUrl !== null && \is_string($apiKey) && $apiKey !== ''
	? new MonitorSink($monitorUrl, $apiKey, $outDir)
	: new JsonlFileSink($outDir);

exit((new TelemetryAgent(new Aggregator(), $sink))->run($host, $port, $maxRuntime));
